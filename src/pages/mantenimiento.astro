---
const title = "402 ";
const description = "STATUS_402";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<style>
			body, html {
				margin: 0;
				padding: 0;
				height: 100vh;
				background-color: #ffffff;
				color: #aaaaaa;
				font-family: 'Courier New', Courier, monospace;
				display: flex;
				justify-content: center;
				align-items: center;
				overflow: hidden;
			}

			.error-container {
				text-align: center;
				letter-spacing: 3px;
			}

			h1 {
				font-size: clamp(2rem, 5vw, 3rem);
				font-weight: normal;
				margin: 0;
				color: #000000;
			}
            
            p {
                margin-top: 15px;
                font-size: clamp(1rem, 2vw, 1.2rem);
                color: #777777;
            }
		</style>
	</head>
	<body>
		<div class="error-container">
			<h1>STATUS_402</h1>
			<p></p>
		</div>
	</body>
</html>
