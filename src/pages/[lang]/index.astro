---
import '../../styles/pages/home.css';
import Layout from '../../layouts/Layout.astro';
import Intro from '../../components/Intro.astro';
import HeroSlider from '../../components/HeroSlider.astro';
import AreaPreviewGrid from '../../components/AreaPreviewGrid.astro';
import StatsGrid from '../../components/StatsGrid.astro';
import CommitmentGrid from '../../components/CommitmentGrid.astro';
import NovedadesCarousel from '../../components/NovedadesCarousel.astro';
import VideoCarousel from '../../components/VideoCarousel.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { getImage } from 'astro:assets';
import homeData from '../../data/home.json';
import es from '../../data/es.json';
import en from '../../data/en.json';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = lang === 'en' ? en : es;
const slides = homeData.hero.slides;
const novedadesData = homeData.novedades_empresas[lang as 'es' | 'en'];
const ctaText = t["home.cta.about"];

// Optimizar imágenes de fondo
const parallax1 = await getImage({
    src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=1600&q=80',
    width: 1600,
    height: 900,
    format: 'webp'
});

const parallax2 = await getImage({
    src: 'https://images.unsplash.com/photo-1507679799987-c73779587ccf?w=1600&q=80',
    width: 1600,
    height: 900,
    format: 'webp'
});

const areaItems = homeData.practice_areas[lang as 'es' | 'en'].map((item, index) => ({
    ...item,
    num: `0${index + 1}`,
    href: `/${lang}${item.link}`
}));

/* 
const videoCarouselItems = [
    {
        id: '1',
        title: lang === 'en' ? 'Legal Excellence' : 'Excelencia Legal',
        description: lang === 'en' ? 'Our commitment to your defense' : 'Nuestro compromiso con su defensa',
        videoUrl: 'https://cdn.pixabay.com/video/2026/04/08/345137_large.mp4'
    },
    {
        id: '2',
        title: lang === 'en' ? 'Corporate Strategy' : 'Estrategia Corporativa',
        description: lang === 'en' ? 'Protecting your business assets' : 'Protegiendo los activos de su empresa',
        videoUrl: 'https://cdn.pixabay.com/video/2024/02/09/199738-911197779_tiny.mp4'
    },
    {
        id: '3',
        title: lang === 'en' ? 'Expert Consultation' : 'Asesoría Especializada',
        description: lang === 'en' ? 'Direct contact with experts' : 'Contacto directo con especialistas',
        videoUrl: 'https://cdn.pixabay.com/video/2021/04/01/71340-539066606_tiny.mp4'
    },
    {
        id: '4',
        title: lang === 'en' ? 'Global Reach' : 'Alcance Global',
        description: lang === 'en' ? 'Legal solutions worldwide' : 'Soluciones legales en todo el mundo',
        videoUrl: 'https://cdn.pixabay.com/video/2021/08/13/84931-587289569_tiny.mp4'
    }
];
*/
---

<Layout 
    title={slides[0][lang as 'es' | 'en'].title} 
    lang={lang}
    description={slides[0][lang as 'es' | 'en'].subtitle}
>
    <Intro />
    <HeroSlider slides={slides} lang={lang!} videoSrc="https://videos.pexels.com/video-files/5598970/5598970-uhd_2560_1440_24fps.mp4" />

    <!-- Se comenta también el componente en el HTML ya que los datos no están disponibles -->
    <!-- 
    <VideoCarousel 
        lang={lang!} 
        title={t["home.videoCarousel.title"]} 
        items={videoCarouselItems} 
    />
    -->

    <!-- AREAS PREVIEW -->
    <section class="home-areas content-below-diagonal diagonal-left">
        <div class="container">
            <div class="section-title">
                <h2>{t["home.areas.title"]}</h2>
                <p>{t["home.areas.subtitle"]}</p>
            </div>
            
            <AreaPreviewGrid lang={lang!} areas={areaItems} />

            <div class="view-more-link">
                <a href={`/${lang}/areas`}>{t["home.areas.viewAll"]}</a>
            </div>
        </div>
    </section>

    <!-- STATISTICS SECTION -->
    <section class="home-stats content-below-diagonal diagonal-right">
        <div class="container">
            <StatsGrid stats={homeData.stats[lang as 'es' | 'en']} />
        </div>
    </section>

    <!-- PARALLAX SECTION 1 - RECONOCIMIENTOS -->
    <section class="parallax-section content-below-diagonal diagonal-left" data-parallax style={`background-image: url('${parallax1.src}')`}>
        <div class="parallax-overlay"></div>
        <div class="parallax-content container">
            <span class="parallax-label">{t["home.parallax1.label"]}</span>
            <h2>{t["home.parallax1.title"]}</h2>
            <p>{t["home.parallax1.desc"]}</p>
            <a href={`/${lang}/nosotros`} class="btn-outline">{t["nav.about"]}</a>
        </div>
    </section>

    <!-- COMMITMENT SECTION -->
    <section class="home-commitment content-below-diagonal diagonal-right">
        <div class="container">
            <div class="section-title">
                <h2>{homeData.commitment[lang as 'es' | 'en'].title}</h2>
            </div>
            <CommitmentGrid items={homeData.commitment[lang as 'es' | 'en'].items} />
        </div>
    </section>

    <!-- NOVEDADES -->
    <section class="home-novedades content-below-diagonal diagonal-left">
        <div class="container">
            <div class="section-title">
                <h2>{novedadesData.title}</h2>
            </div>
            <NovedadesCarousel lang={lang!} items={novedadesData.items} />
        </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="home-faq content-below-diagonal diagonal-right">
        <div class="container">
            <div class="section-title">
                <h2>{homeData.faqs[lang as 'es' | 'en'].title}</h2>
            </div>
            <FaqAccordion items={homeData.faqs[lang as 'es' | 'en'].items} />
        </div>
    </section>

    <!-- PARALLAX SECTION 2 - CONTACTO -->
    <section class="parallax-section content-below-diagonal" data-parallax style={`background-image: url('${parallax2.src}')`}>
        <div class="parallax-overlay"></div>
        <div class="parallax-content container centered">
            <span class="parallax-label">{t["home.parallax2.label"]}</span>
            <h2>{t["home.parallax2.title"]}</h2>
            <p>{t["home.parallax2.desc"]}</p>
            <a href={`/${lang}/contactenos`} class="btn-outline">{t["nav.contact"]}</a>
        </div>
    </section>
</Layout>

<script>
    import { initScrollAnimations } from '../../utils/animations';

    // Initialize on first load and after every View Transition
    document.addEventListener('astro:page-load', initScrollAnimations);
</script>