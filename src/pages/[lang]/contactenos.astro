---
import '../../styles/pages/contactenos.css';
import Layout from '../../layouts/Layout.astro';
import contactData from '../../data/contact.json';
import es from '../../data/es.json';
import en from '../../data/en.json';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = lang === 'en' ? en : es;
const data = contactData[lang as 'es' | 'en'];
const heroImg = 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=1600&q=80';
---

<Layout title={data.title} lang={lang} description={data.subtitle}>
	<section class="contact-hero">
		<h1 class="hero-title">{data.title}</h1>
		<p class="hero-subtitle">{data.subtitle}</p>
	</section>

	<section class="contact-section">
		<div class="contact-content">
		  
		  <!-- MITAD IZQUIERDA (Info + Mapa) -->
		  <div class="contact-left-sticky">
		    <div class="contact-details fade-up">
		      <div class="contact-item">
		        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
		        <div class="item-text">
		          <strong>{t['contact.label.address']}</strong>
		          <span>{data.info.address}</span>
		        </div>
		      </div>
		      <div class="contact-item">
		        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
		        <div class="item-text">
		          <strong>{t['contact.label.phone']}</strong>
		          <a href={`tel:${data.info.phone.replace(/[^0-9+]/g, '')}`}>{data.info.phone}</a>
		        </div>
		      </div>
		      <div class="contact-item">
		        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
		        <div class="item-text">
		          <strong>{t['contact.label.email']}</strong>
		          <a href={`mailto:${data.info.email}`}>{data.info.email}</a>
		        </div>
		      </div>
		      <div class="contact-item">
		        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
		        <div class="item-text">
		          <strong>{t['contact.label.hours']}</strong>
		          <span>{data.info.hours}</span>
		        </div>
		      </div>
		    </div>

		    <!-- Mapa Minimalista Invertido -->
		    <div class="map-container fade-up">
		       <iframe 
		        src={data.mapUrl}
		        width="100%" 
		        height="100%" 
		        style="border:0;" 
		        allowfullscreen="" 
		        loading="lazy" 
		        referrerpolicy="no-referrer-when-downgrade">
		      </iframe>
		    </div>
		  </div>
		  
		  <!-- MITAD DERECHA (Formulario Largo) -->
		  <div class="contact-right-scroll fade-up">
		    <h3 class="form-title">{data.form.submit}</h3>
		    
		    <!-- Formulario Elegante -->
		    <form class="elegant-form" id="contactForm">
		      <div class="input-group">
		        <input type="text" id="name" name="name" required placeholder=" " />
		        <label for="name">{data.form.name}</label>
		      </div>
		      
		      <div class="input-group">
		        <input type="email" id="email" name="email" required placeholder=" " />
		        <label for="email">{data.form.email}</label>
		      </div>
		      
		      <div class="input-group">
		        <input type="tel" id="phone" name="phone" placeholder=" " />
		        <label for="phone">{data.form.phone}</label>
		      </div>

		      <div class="input-group">
		        <select id="service" name="service" required>
		          <option value="" disabled selected></option>
		          <option value="corporate">{data.form.serviceOptions.corporate}</option>
		          <option value="tax">{data.form.serviceOptions.tax}</option>
		          <option value="litigation">{data.form.serviceOptions.litigation}</option>
		          <option value="other">{data.form.serviceOptions.other}</option>
		        </select>
		        <label for="service">{data.form.service}</label>
		      </div>
		      
		      <div class="input-group">
		        <textarea id="message" name="message" rows="4" required placeholder=" "></textarea>
		        <label for="message">{data.form.message}</label>
		      </div>
		      
		      <button type="submit" class="btn-gold" id="submitBtn">
		         <span class="btn-text">{data.form.submit}</span>
		         <span class="loader" style="display:none;"></span>
		      </button>
		      <div id="formStatus" class="form-status" role="alert"></div>
		    </form>
		  </div>
		</div>
	</section>
</Layout>

<script>
	import { initContactForm } from '../../utils/formHandler';
	document.addEventListener('astro:page-load', initContactForm);
</script>
