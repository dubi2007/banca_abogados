---
import '../styles/components/videohero.css';
interface Slide {
    id: string;
    image: string;
    es: { title: string; subtitle: string; ctaText: string };
    en: { title: string; subtitle: string; ctaText: string };
    ctaHref: string;
}

interface Props {
	slides: Slide[];
	lang: string;
	videoSrc?: string;
}

const { slides, lang, videoSrc = 'https://videos.pexels.com/video-files/5598970/5598970-uhd_2560_1440_24fps.mp4' } = Astro.props;
---


<section class="hero-premium" id="heroPremium">
    <!-- Video Background -->
    <div class="hero-bg">
        <video
            class="hero-video"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            id="mainHeroVideo"
        >
            <source src={videoSrc} type="video/mp4" />
        </video>
        <div class="hero-overlay"></div>
    </div>

    <!-- Content -->
    <div class="hero-slider">
        {slides.map((slide, index) => (
            <div class={`hero-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                <div class="container hero-container">
                    <div class="hero-content-box">
                        <h1 class="hero-title">
                            {slide[lang as 'es' | 'en'].title}
                        </h1>
                        <p class="hero-subtitle">
                            {slide[lang as 'es' | 'en'].subtitle}
                        </p>
                        <div class="hero-actions">
                            <a href={slide.ctaHref} class="btn-gold">
                                {slide[lang as 'es' | 'en'].ctaText}
                            </a>
                            <a href={`/${lang}/contactenos`} class="btn-outline-white">
                                {lang === 'en' ? 'CONTACT US' : 'CONTÁCTENOS'}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        ))}
    </div>

    <!-- Centered Dots Navigation -->
    <div class="hero-nav-dots">
        {slides.map((_, index) => (
            <button 
                class={`dot-item ${index === 0 ? 'active' : ''}`} 
                data-index={index} 
                aria-label={`Go to slide ${index + 1}`}
            >
                <span class="dot-inner"></span>
            </button>
        ))}
    </div>
</section>



<script>
    function initHeroSlider() {
        const hero = document.getElementById('heroPremium');
        if (!hero) return;

        const slides = hero.querySelectorAll('.hero-slide');
        const dots = hero.querySelectorAll('.dot-item');
        let current = 0;
        let timer: any;

        function showSlide(index: number) {
            slides.forEach(s => s.classList.remove('active'));
            dots.forEach(d => d.classList.remove('active'));

            slides[index].classList.add('active');
            dots[index].classList.add('active');

            current = index;
            resetTimer();
        }

        function nextSlide() {
            let next = (current + 1) % slides.length;
            showSlide(next);
        }

        function resetTimer() {
            clearInterval(timer);
            timer = setInterval(nextSlide, 7000);
        }

        dots.forEach((dot, idx) => {
            dot.addEventListener('click', () => showSlide(idx));
        });

        resetTimer();
    }

    document.addEventListener('astro:page-load', initHeroSlider);
</script>
