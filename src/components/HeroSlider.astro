---
interface Slide {
    id: string;
    image: string;
    es: { title: string; subtitle: string; ctaText: string };
    en: { title: string; subtitle: string; ctaText: string };
    ctaHref: string;
}

interface Props {
	slides: Slide[];
	lang: string;
}

const { slides, lang } = Astro.props;
---

<section class="hero-slider">
    {slides.map((slide, index) => (
        <div class={`slide ${index === 0 ? 'active' : ''}`} data-index={index}>
            <!-- Imagen de fondo -->
            <div class="slide-bg" style={`background-image: url('${slide.image}')`}></div>
            
            <!-- Capas de Oscurecimiento para mejorar visibilidad -->
            <div class="overlay-full"></div>
            <div class="overlay-top"></div>
            <div class="overlay-bottom"></div>

            <!-- Contenido -->
            <div class="slide-content container">
                <div class="content-box">
                    <h2 class="slide-title">
                        {slide[lang as 'es' | 'en'].title.split(' ').map((word, i) => (
                            <span class={i === 1 ? 'highlight' : ''}>{word} </span>
                        ))}
                    </h2>
                    <p class="slide-subtitle">{slide[lang as 'es' | 'en'].subtitle}</p>
                    <a href={slide.ctaHref} class="slide-cta">
                        {slide[lang as 'es' | 'en'].ctaText}
                    </a>
                </div>
            </div>
        </div>
    ))}

    <!-- Controles -->
    <div class="slider-dots">
        {slides.map((_, index) => (
            <button class={`dot ${index === 0 ? 'active' : ''}`} data-index={index}></button>
        ))}
    </div>
</section>

<style>
    .hero-slider {
        position: relative;
        height: 100vh;
        width: 100%;
        overflow: hidden;
        background: #000;
    }

    .slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
        transition: opacity 1.2s ease-in-out, visibility 1.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .slide.active {
        opacity: 1;
        visibility: visible;
        z-index: 10;
    }

    .slide-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        transform: scale(1.15);
        transition: transform 8s linear;
    }

    .active .slide-bg {
        transform: scale(1);
    }

    /* MEJORA DE VISIBILIDAD: Overlays */
    .overlay-full {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.35); /* Capa base de oscurecimiento */
        z-index: 2;
    }

    .overlay-top {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 40%;
        background: linear-gradient(to bottom, rgba(0,0,0,0.85) 0%, transparent 100%);
        z-index: 3;
    }

    .overlay-bottom {
        position: absolute;
        bottom: 0; left: 0; width: 100%; height: 60%;
        background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.5) 30%, transparent 100%);
        z-index: 3;
    }

    .slide-content {
        position: relative;
        z-index: 10;
        text-align: center;
        color: #fff;
        max-width: 900px;
        padding: 0 20px;
    }

    .content-box {
        opacity: 0;
        transform: translateY(40px);
        transition: all 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.6s;
    }

    .active .content-box {
        opacity: 1;
        transform: translateY(0);
    }

    .slide-title {
        font-family: 'Playfair Display', serif;
        font-size: 5.5rem;
        margin-bottom: 1.5rem;
        line-height: 1.1;
        font-weight: 700;
        /* Sombra de texto para máxima legibilidad */
        text-shadow: 0 10px 30px rgba(0,0,0,0.8), 0 0 80px rgba(0,0,0,0.4);
        letter-spacing: -1px;
    }

    .slide-title .highlight {
        color: #D4AF37;
        text-shadow: 0 10px 30px rgba(0,0,0,0.8), 0 0 40px rgba(212,175,55,0.2);
    }

    .slide-subtitle {
        font-family: 'Inter', sans-serif;
        font-size: 1.4rem;
        margin-bottom: 3.5rem;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.6;
        color: #f0f0f0;
        font-weight: 300;
        text-shadow: 0 2px 10px rgba(0,0,0,0.8);
    }

    .slide-cta {
        display: inline-block;
        padding: 1.2rem 3.5rem;
        border: 1px solid rgba(255,255,255,0.8);
        color: #fff;
        text-decoration: none;
        letter-spacing: 3px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        background: rgba(0,0,0,0.2);
        backdrop-filter: blur(5px);
    }

    .slide-cta:hover {
        background: #fff;
        color: #000;
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.3);
    }

    .slider-dots {
        position: absolute;
        bottom: 50px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 20;
        display: flex;
        gap: 15px;
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.5);
        background: transparent;
        cursor: pointer;
        padding: 0;
        transition: all 0.3s ease;
    }

    .dot.active {
        background: #D4AF37;
        border-color: #D4AF37;
        transform: scale(1.3);
        box-shadow: 0 0 15px rgba(212,175,55,0.5);
    }

    @media (max-width: 768px) {
        .slide-title { font-size: 3.2rem; }
        .slide-subtitle { font-size: 1.1rem; }
        .slide-cta { padding: 1rem 2.5rem; }
    }
</style>

<script>
    function initHeroSlider() {
        const slides = document.querySelectorAll('.slide');
        const dots = document.querySelectorAll('.dot');
        let currentSlide = 0;
        const slideInterval = 7000; // Un poco más lento para mejor lectura

        function showSlide(index: number) {
            if (slides.length === 0) return;
            slides.forEach(s => s.classList.remove('active'));
            dots.forEach(d => d.classList.remove('active'));
            
            slides[index].classList.add('active');
            dots[index].classList.add('active');
            currentSlide = index;
        }

        function nextSlide() {
            let next = (currentSlide + 1) % slides.length;
            showSlide(next);
        }

        let interval = setInterval(nextSlide, slideInterval);

        dots.forEach((dot, idx) => {
            dot.addEventListener('click', () => {
                showSlide(idx);
                clearInterval(interval);
                interval = setInterval(nextSlide, slideInterval);
            });
        });
    }

    document.addEventListener('astro:page-load', initHeroSlider);
</script>
