---
import '../styles/components/introhero.css';
---
<div id="intro-overlay" class="intro-overlay" aria-hidden="true">
    <div class="intro-bg-gradient"></div>
    <div class="intro-bg-noise"></div>

    <div class="intro-frame" aria-hidden="true">
        <span class="line line-top"></span>
        <span class="line line-bottom"></span>
        <span class="line line-left"></span>
        <span class="line line-right"></span>
    </div>

    <div class="intro-content">
      

        <div class="intro-text">
            <h1 class="intro-title">FAYNSHTEYN</h1>
            <div class="intro-separator"></div>
            <p class="intro-subtitle" id="intro-last-element">ABOGADOS &amp; CONSULTORES</p>
        </div>
    </div>
</div>



<script>
    const setupIntro = () => {
        const intro = document.getElementById('intro-overlay');
        if (!intro) return;

        // Usamos una variable en el objeto window. 
        // Se mantiene mientras navegues (SPA), pero se borra al recargar la página por completo.
        if ((window as any).introHasPlayed) {
            intro.remove();
            return;
        }

        const FADE_TIME = 1200;
        const DISPLAY_TIME = 6500; // Tiempo total que la intro permanece visible

        const hide = () => {
            intro.classList.add('is-hidden');
            (window as any).introHasPlayed = true;
            
            setTimeout(() => {
                if (intro && intro.parentNode) {
                    intro.remove();
                }
            }, FADE_TIME);
        };

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        
        if (reduceMotion) {
            setTimeout(hide, 1000);
        } else {
            // Se asegura de que la animación se complete
            setTimeout(hide, DISPLAY_TIME);
        }
    };

    // Ejecutar en cada carga de página (soporta View Transitions)
    document.addEventListener('astro:page-load', setupIntro);
</script>
