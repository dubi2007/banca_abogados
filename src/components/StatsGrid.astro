---
interface Stat {
    label: string;
    value: string;
}

interface Props {
    stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="stats-grid">
    {stats.map((stat) => (
        <div class="stat-item">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
        </div>
    ))}
</div>
