---
import partnersData from '../data/partners.json';
import '../styles/components/logocarrusel.css';

const { partners } = partnersData;
// Duplicamos los partners para el efecto infinito
const duplicatedPartners = [...partners, ...partners, ...partners];
---

<section class="logo-carousel-section">
    <div class="carousel-container">
        <div class="logo-track">
            {duplicatedPartners.map((partner) => (
                <div class="logo-item">
                    <img src={partner.logo} alt={partner.name} title={partner.name} />
                </div>
            ))}
        </div>
    </div>
</section>


