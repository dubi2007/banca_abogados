---
interface Props {
  items: { label: string; href?: string }[];
  lang: string;
}

const { items, lang } = Astro.props;
---

<nav class="breadcrumbs container" aria-label="Breadcrumb">
  <ol>
    <li>
      <a href={`/${lang}/`}>{lang === 'en' ? 'Home' : 'Inicio'}</a>
    </li>
    {items.map((item, index) => (
      <li>
        <span class="separator">/</span>
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span class="current" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding: 1.5rem 2rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .breadcrumbs a:hover {
    color: var(--color-gold);
  }
  .breadcrumbs .separator {
    color: var(--border-light);
    font-weight: 300;
  }
  .breadcrumbs .current {
    color: var(--color-gold);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
</style>
