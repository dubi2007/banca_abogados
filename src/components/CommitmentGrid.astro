---
interface Item {
    title: string;
    desc: string;
}

interface Props {
    items: Item[];
}

const { items } = Astro.props;

// SVG icons for commitments (Shield, Eye/Strategy, Check/Results)
const icons = [
    // Shield (Ethics)
    '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
    // Eye/Compass (Strategy)
    '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>',
    // Check-circle/Results
    '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><polyline points="22 4 12 14.01 9 11.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>'
];
---

<div class="commitment-grid">
    {items.map((item, index) => (
        <div class="commitment-item">
            <div class="commitment-icon-wrap">
                <svg width="36" height="36" viewBox="0 0 24 24" class="commitment-icon" set:html={icons[index % icons.length]} />
            </div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
        </div>
    ))}
</div>
