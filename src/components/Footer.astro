---
import '../styles/components/footer.css';
import { useTranslations } from '../utils/i18n';
import SocialIcons from './SocialIcons.astro';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="main-footer">
  <div class="footer-grid container">
    <!-- COL 1: Info Empresa -->
    <div class="footer-info">
      <div class="logo">FAYNSHTEYN</div>
      <p class="footer-desc">
        {t("footer.description")}
      </p>
      <SocialIcons />
    </div>

    <!-- COL 2: Navegación -->
    <div class="footer-links">
      <h3>{t("footer.nav")}</h3>
      <ul>
        <li><a href={`/${lang}/nosotros`}>{t("nav.about")}</a></li>
        <li><a href={`/${lang}/areas`}>{t("nav.areas")}</a></li>
        <li><a href={`/${lang}/sedes`}>{t("nav.locations")}</a></li>
        <li><a href={`/${lang}/directorio`}>{t("nav.directory")}</a></li>
      </ul>
    </div>

    <!-- COL 3: Servicios / Otros -->
    <div class="footer-links">
      <h3>{t("footer.services")}</h3>
      <ul>
        <li><a href={`/${lang}/productos-legales`}>{t("nav.products")}</a></li>
        <li><a href={`/${lang}/novedades`}>{t("nav.news")}</a></li>
        <li><a href={`/${lang}/contactenos`}>{t("nav.contact")}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom container">
    <hr class="footer-divider" />
    <div class="footer-bottom-flex">
      <p class="footer-copyright">&copy; {new Date().getFullYear()} {t("footer.copyright")}</p>
      <div class="footer-trust">
        <a href="#" onclick="window.open('https://www.sitelock.com/verify.php?site=faynshteynjuridico.com','SiteLock','width=600,height=600,left=160,top=170');" ><img class="img-fluid sitelock-shield" alt="SiteLock" title="SiteLock" src="https://shield.sitelock.com/shield/faynshteynjuridico.com" /></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-bottom-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .sitelock-shield {
    max-width: 100px;
    height: auto;
    cursor: pointer;
  }
  @media (max-width: 768px) {
    .footer-bottom-flex {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
