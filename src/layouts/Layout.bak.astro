---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LogoCarousel from '../components/LogoCarousel.astro';
import Schema from '../components/Schema.astro';
import { ClientRouter } from 'astro:transitions';
import es from '../data/es.json';
import en from '../data/en.json';

interface Props {
	title: string;
	lang?: string;
	description?: string;
	image?: string;
	canonical?: string;
	preloadImage?: string;
}

const { 
	title, 
	lang = 'es', 
	description = lang === 'en' ? en["footer.description"] : es["footer.description"],
	image = '/og-image.jpg', // Ruta de imagen por defecto
	canonical = Astro.url.href,
	preloadImage
} = Astro.props;

const siteName = 'Faynshteyn Abogados';
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<script is:inline>
			if (!window.location.pathname.startsWith('/mantenimiento')) {
				window.location.href = '/mantenimiento';
			}
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/images/intro/logo_fondo_transparente.png" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO -->
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		{preloadImage && <link rel="preload" as="image" href={preloadImage} />}

		<!-- I18N HREFLANG -->
		<link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site)} />
		<link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/es/', Astro.site)} />

		<!-- OPEN GRAPH / FACEBOOK -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- TWITTER -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={fullTitle} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

		<!-- FONTS -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
		
		<Schema lang={lang as 'es' | 'en'} />
		
		<ClientRouter />
	</head>
	<body>
		<Header lang={lang} />
		<main>
			<slot />
		</main>
		<LogoCarousel />
		<Footer lang={lang} />
	</body>
</html>
